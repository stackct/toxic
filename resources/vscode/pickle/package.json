{
  "name": "pickle",
  "publisher": "dotariel",
  "displayName": "Pickle Explorer",
  "description": "Code snippets, content navigation, and test execution support for Pickle.",
  "repository": {},
  "version": "0.0.1",
  "icon": "resources/pickle-icon-128x128.png",
  "engines": {
    "vscode": "^1.32.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:toxic/**/*.test",
    "workspaceContains:toxic/**/*.fn",
    "workspaceContains:toxic/**/*.dep"
  ],
  "main": "./out/extension",
  "contributes": {
    "snippets": [
      {
        "language": "groovy",
        "path": "./snippets/pickle.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Pickle configuration",
      "properties": {
        "pickle.runtimeArgs": {
          "type": "array",
          "description": "List of runtime arguments in the format: -key=value"
        },
        "pickle.notifications.success": {
          "type": "boolean",
          "description": "Enable notifications for successful tests",
          "default": true
        },
        "pickle.notifications.failure": {
          "type": "boolean",
          "description": "Enable notifications for failed tests",
          "default": true
        },
        "pickle.expand.tests": {
          "type": "boolean",
          "description": "Expand test files to show all test cases",
          "default": false
        },
        "pickle.codecompletion.enable": {
          "type": "boolean",
          "description": "Enable Pickle Functions Code Completion",
          "default": true
        },
        "pickle.codecompletion.trigger": {
          "type": "string",
          "description": "Code Completion trigger character. Must be a single character",
          "default": "."
        },
        "pickle.terminal.enable": {
          "type": "boolean",
          "description": "Enable Pickle Terminal",
          "default": true
        },
        "pickle.terminal.enableCustomColors": {
          "type": "boolean",
          "description": "Enable custom colors for Pickle terminal",
          "default": true
        }
      }
    },
    "commands": [
      {
        "title": "Locate",
        "command": "pickle.openFile",
        "icon": "resources/edit.svg"
      },
      {
        "title": "Run All",
        "command": "pickle.runAll",
        "icon": "resources/stack.svg"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pickle-explorer",
          "title": "Pickle Explorer",
          "icon": "resources/pickle-icon.png"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pickle.runAll",
          "when": "view == pickle-tests",
          "group": "navigation"
        }
      ],
      "commandPalette": []
    },
    "views": {
      "pickle-explorer": [
        {
          "id": "pickle-deps",
          "name": "Dependencies",
          "when": "activated"
        },
        {
          "id": "pickle-functions",
          "name": "Functions",
          "when": "activated"
        },
        {
          "id": "pickle-tests",
          "name": "Tests",
          "when": "activated"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn install && yarn compile",
    "clean": "rm -fr ./node_modules && rm -fr ./out",
    "compile": "./node_modules/.bin/tsc -p ./",
    "watch": "./node_modules/.bin/tsc -watch -p ./",
    "pretest": "yarn compile",
    "test": "yarn compile && node ./out/test/run-test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.28",
    "@types/vscode": "^1.32.0",
    "@vscode/test-electron": "^2.3.9",
    "mocha": "^10.3.0",
    "testrunner": "^1.0.4",
    "tslint": "^6.1.3",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "@vscode/vsce": "^3.3.2"
  }
}
