function "Redirect" {
  description "Follow the location of the previous response"
  path "{{ libPath }}/http/redirect"

  input "redirectHttpUri"
  input "redirectHttpMethod"
  input "authCookie", false
  input "cookies", false

  output "redirectUrl"
  output "redirectHttpUri"
  output "redirectHttpMethod"
}

function "ParseUri" {
  description "Deconstructs a uri"
  path "{{ libPath }}/http/parse_uri"

  input "uri"

  output "path"
  output "scheme"
  output "host"
  output "port"
  output "queryParams"
}

function "MultipartForm" {
  description "Sends a multipart/form-data POST request"
  path "{{ libPath }}/http/multipart_form"

  input "url"
  input "fields"  // comma-separated list of field names
  input "values"  // comma-separated list of field values

  input "cookie", false
  input "bearer", false
  input "compressed", false, "true"

  output "response"
  output "json"
}
